# Copie para .env e preencha com valores REAIS (o .env é gitignored e nunca vai pro git).
# Estes são apenas marcadores — não são segredos.

# Banco de dados
POSTGRES_USER=ragnarok
POSTGRES_PASSWORD=__DEFINA_UMA_SENHA_FORTE__
POSTGRES_DB=ragnarok

# Segurança — gere valores aleatórios fortes, ex.: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=__GERE_UM_VALOR_ALEATORIO__
JWT_SECRET_KEY=__GERE_UM_VALOR_ALEATORIO_COM_NO_MINIMO_32_BYTES__

# Admin inicial criado pelo seed (se vazio, o seed gera uma senha aleatória e imprime no log)
SEED_ADMIN_EMAIL=admin@ragnarok.local
SEED_ADMIN_PASSWORD=__DEFINA_A_SENHA_DO_ADMIN__
SEED_ADMIN_NAME=Administrador
